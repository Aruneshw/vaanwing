# ---- API keys (set the ones for the providers you use) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- models per role (Claude IDs use the Anthropic SDK; anything else goes through LiteLLM; "none" disables) ----
MODEL_TUTOR=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
MODEL_VERIFIER=claude-sonnet-5-5       # e.g. openai/gpt-4o to verify with a different provider
MODEL_VISION=claude-sonnet-5-5         # e.g. gemini/gemini-2.0-flash
MODEL_JUDGE=claude-sonnet-5-5
TUTOR_EFFORT=medium

# ---- embeddings: hash (offline), fastembed (local), or a LiteLLM model like openai/text-embedding-3-small ----
EMBEDDING_MODEL=hash

# ---- infrastructure ----
DATABASE_URL=sqlite:///./studynest.db
# DATABASE_URL=postgresql+psycopg://studynest:studynest@localhost:5432/studynest
REDIS_URL=
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
